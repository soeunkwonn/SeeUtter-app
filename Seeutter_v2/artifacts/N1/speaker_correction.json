      "end": 119.14,
      "span_duration": 1.5,
      "speech_duration": 1.2199999999999989,
      "text": "Whoo! That a girl."
    },
    {
      "run_index": 30,
      "speaker": "FACE_5",
      "segment_indices": [
        48
      ],
      "start": 120.4,
      "end": 121.26,
      "span_duration": 0.8599999999999994,
      "speech_duration": 0.8599999999999994,
      "text": "We're all set."
    },
    {
      "run_index": 31,
      "speaker": "3",
      "segment_indices": [
