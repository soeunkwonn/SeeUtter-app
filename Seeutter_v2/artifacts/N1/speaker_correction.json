      "span_duration": 3.359999999999985,
      "speech_duration": 3.1399999999999864,
      "text": "Right, right. Uh, what, y'all need a tow or something?"
    },
    {
      "run_index": 26,
      "speaker": "FACE_1",
      "segment_indices": [
        42,
        43
      ],
      "start": 105.82,
      "end": 108.46,
      "span_duration": 2.6400000000000006,
      "speech_duration": 2.4200000000000017,
      "text": "No, thank you, officer. I think I gotta, just give me my..."
