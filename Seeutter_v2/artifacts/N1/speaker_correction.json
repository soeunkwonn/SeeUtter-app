      "segment_indices": [
        36
      ],
      "start": 95.06,
      "end": 95.56,
      "span_duration": 0.5,
      "speech_duration": 0.5,
      "text": "Yes. Absolutely."
    },
    {
      "run_index": 22,
      "speaker": "4",
      "segment_indices": [
        37
      ],
      "start": 95.82,
      "end": 97.2,
      "span_duration": 1.3800000000000097,
      "speech_duration": 1.3800000000000097,
      "text": "Whole damn country's counting on them."
    },
    {
      "run_index": 23,
      "speaker": "FACE_1",
      "segment_indices": [
        38
      ],
      "start": 97.34,
      "end": 98.26,
      "span_duration": 0.9200000000000017,
      "speech_duration": 0.9200000000000017,
      "text": "That's for certain."
    },
    {
      "run_index": 24,
      "speaker": "10",
      "segment_indices": [
        39
      ],
      "start": 98.64,
      "end": 101.42,
      "span_duration": 2.780000000000001,
      "speech_duration": 2.780000000000001,
      "text": "Hard being of service is broken down on the side of the road, though."
    },
    {
      "run_index": 25,
      "speaker": "FACE_2",
      "segment_indices": [
        40,
        41
      ],
      "start": 102.24000000000001,
