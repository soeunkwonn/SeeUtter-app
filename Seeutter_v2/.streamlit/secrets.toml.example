# Copy this into Streamlit Community Cloud → App → Settings → Secrets.
# (Do NOT commit a filled-in secrets.toml to GitHub.)

# OpenAI key (kept for compatibility; naming no longer re-translates).
OPENAI_API_KEY = "sk-..."

[google]
# OAuth *user* credentials (not a service account). Get these by running
# get_oauth_token.py once with your downloaded OAuth client_secret.json.
client_id = "...apps.googleusercontent.com"
client_secret = "..."
refresh_token = "1//..."
# ID from the Drive folder URL:  drive.google.com/drive/folders/<THIS_PART>
drive_folder_id = "..."
# ID from the Sheet URL:  docs.google.com/spreadsheets/d/<THIS_PART>/edit
sheet_id = "..."
